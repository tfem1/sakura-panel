{
  "name": "sakura-panel",
  "productName": "SAKURA PANEL",
  "version": "1.0.0",
  "description": "SAKURA PANEL — premium graphics control panel for Windows.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "brand": "node scripts/brand.js",
    "test": "node tests/e2e.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "opentype.js": "^2.0.0"
  },
  "build": {
    "appId": "com.sakurapanel.app",
    "productName": "SAKURA PANEL",
    "copyright": "SAKURA PANEL",
    "files": [
      "electron/**",
      "src/**",
      "assets/icons/sakura-panel.ico",
      "assets/icons/taskbar.ico",
      "assets/icons/taskbar-icon-32.png"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icons/sakura-panel.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SAKURA PANEL",
      "installerIcon": "assets/icons/sakura-panel.ico",
      "uninstallerIcon": "assets/icons/sakura-panel.ico"
    }
  }
}
